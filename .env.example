ENV=development
JWT_SECRET=dev-secret-change-in-production
DATABASE_URL=postgres://payment:payment@localhost:5432/payment_platform?sslmode=disable
REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:9092
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318

AUTH_SERVICE_URL=http://localhost:8001
PAYMENT_SERVICE_URL=http://localhost:8002
WALLET_SERVICE_URL=http://localhost:8004
LEDGER_SERVICE_URL=http://localhost:8005
ADMIN_SERVICE_URL=http://localhost:8011

WEBHOOK_SECRET_STRIPE=whsec_test_stripe
WEBHOOK_SECRET_RAZORPAY=whsec_test_razorpay
WEBHOOK_SECRET_PAYPAL=whsec_test_paypal

# Feature flags
FEATURE_REFUND_SAGA=true
FEATURE_PAYMENT_HOLDS=true
FEATURE_AUTO_RECONCILE=true
FEATURE_MULTI_PROVIDER=true

# Notifications (log-based demo)
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=true
